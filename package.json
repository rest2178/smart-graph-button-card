{
  "name": "smart-graph-button-card",
  "version": "1.5.0",
  "description": "Self-contained Home Assistant Lovelace button card with icon, name, two values and a built-in SVG history graph. No dependencies on other custom cards.",
  "type": "module",
  "main": "dist/smart-graph-button-card.js",
  "module": "dist/smart-graph-button-card.js",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c --watch",
    "build:nodeps": "node scripts/build.mjs",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "custom-card",
    "hacs",
    "graph",
    "button"
  ],
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "rollup": "^4.24.0"
  },
  "engines": {
    "node": ">=18"
  }
}
